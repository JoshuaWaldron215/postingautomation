# ---- Database (local Postgres 16 or any Postgres/Supabase instance) ----
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/synthos_dev
# Used only by `pnpm test` (integration tests run migrations against this DB)
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/synthos_test

# ---- Application ----
# Base URL the worker and scheduler use to reach the dashboard API
APP_URL=http://localhost:3000
# 32+ random bytes, base64 or hex. Used to sign media/evidence access tokens and encrypt channel secrets.
APP_SECRET=change-me-generate-with-openssl-rand-hex-32
# Private media root (absolute or relative to repo root). Never served statically.
STORAGE_DIR=./storage
# Max upload size in bytes (default 1 GiB)
MAX_UPLOAD_BYTES=1073741824
# DEMO_MODE=true shows the "Demo data" badge and blocks live (non-simulator) posting.
DEMO_MODE=true

# ---- Scheduler process ----
SCHEDULER_TICK_MS=5000
# Workers without a heartbeat for this long are shown Offline and their leases expire.
WORKER_OFFLINE_AFTER_MS=90000

# ---- Worker process (local simulator or the Mac/Hermes worker) ----
# Issued from Settings → Workers. Scoped and revocable. Never commit real values.
WORKER_TOKEN=
# simulator | hermes
WORKER_ADAPTER=simulator
WORKER_NAME=local-simulator
WORKER_POLL_MS=3000
WORKER_MAX_CONCURRENCY=2
# Hermes adapter only (Mac): command that performs one browser action. See docs/mac-worker.md.
HERMES_COMMAND=
HERMES_WORKDIR=
HERMES_PROFILES_DIR=
HERMES_TIMEOUT_MS=900000

# ---- Notifications ----
# Discord webhooks are configured in Settings → Notifications and stored server-side (encrypted with APP_SECRET).
# Nothing is delivered externally until an authorized user runs a labeled test successfully.
